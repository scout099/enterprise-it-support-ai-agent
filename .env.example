# Copy this file to .env for local development. Do not commit .env.
IT_SUPPORT_ENVIRONMENT=development
IT_SUPPORT_DEBUG=false
IT_SUPPORT_LOG_LEVEL=INFO

# These credentials are local-development placeholders only.
POSTGRES_USER=it_support
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=enterprise_it_support
POSTGRES_PORT=5432

IT_SUPPORT_DATABASE_URL=postgresql+psycopg://it_support:change-me-local-only@localhost:5432/enterprise_it_support
IT_SUPPORT_TEST_DATABASE_URL=postgresql+psycopg://it_support:change-me-local-only@localhost:5432/enterprise_it_support_test

IT_SUPPORT_KNOWLEDGE_STORAGE_PATH=data/knowledge
IT_SUPPORT_KNOWLEDGE_MAX_FILE_SIZE_BYTES=5000000
IT_SUPPORT_KNOWLEDGE_CHUNK_SIZE=500
IT_SUPPORT_KNOWLEDGE_CHUNK_OVERLAP=50

# Deterministic local/test default. No external API call is made.
IT_SUPPORT_EMBEDDING_PROVIDER=fake
IT_SUPPORT_EMBEDDING_MODEL=fake-embedding-v1
IT_SUPPORT_EMBEDDING_DIMENSION=8
IT_SUPPORT_EMBEDDING_VERSION=v1
IT_SUPPORT_EMBEDDING_BATCH_SIZE=32
IT_SUPPORT_EMBEDDING_BASE_URL=https://api.openai.com/v1
IT_SUPPORT_RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=10

# For real OpenAI-compatible indexing, set provider=openai, choose a compatible
# model/dimension, and place the key only in your ignored local .env.
# IT_SUPPORT_EMBEDDING_API_KEY=

# Deterministic local/test default for Phase 5 RAG. Real model names are
# configuration, not source-code policy.
IT_SUPPORT_MODEL_PROVIDER=fake
IT_SUPPORT_MODEL_NAME=fake-chat-v1
IT_SUPPORT_MODEL_BASE_URL=https://api.openai.com/v1
IT_SUPPORT_MODEL_TIMEOUT_SECONDS=20
IT_SUPPORT_MODEL_MAX_ATTEMPTS=2
IT_SUPPORT_MODEL_MAX_OUTPUT_TOKENS=1200
IT_SUPPORT_RAG_TOP_K=5
IT_SUPPORT_RAG_MAX_CONTEXT_CHARS=12000
IT_SUPPORT_RAG_MIN_KEYWORD_SCORE=0.001
IT_SUPPORT_RAG_MIN_VECTOR_SIMILARITY=0.75
# Required for a real embedding provider. Must exactly match
# <embedding_model>:<embedding_dimension>:<embedding_version> used for calibration.
# IT_SUPPORT_RAG_VECTOR_THRESHOLD_PROFILE=text-embedding-3-small:1536:v1

# Phase 6 LangGraph runtime bounds and deterministic low-confidence routing.
IT_SUPPORT_AGENT_INTENT_CONFIDENCE_THRESHOLD=0.65
IT_SUPPORT_AGENT_MAX_NODES=12
IT_SUPPORT_AGENT_MAX_RETRIES=1
IT_SUPPORT_AGENT_MAX_TOOL_CALLS=8
IT_SUPPORT_AGENT_NODE_TIMEOUT_SECONDS=15
IT_SUPPORT_AGENT_TIMEOUT_SECONDS=45
IT_SUPPORT_API_BASE_URL=http://127.0.0.1:8000

# WARNING: a real endpoint receives employee questions and authorized enterprise
# Context. Confirm data region/retention/policy before use. Then set provider,
# choose a compatible model, and place the key only in your ignored local .env.
# IT_SUPPORT_MODEL_API_KEY=
